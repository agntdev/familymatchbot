[
  {
    "name": "Telegram sharing stays private without a mutual match",
    "steps": [
      {
        "send": { "callback": "likes:telegram:42" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": { "text": "Telegram доступен только после взаимной симпатии." }
          }
        ]
      }
    ]
  },
  {
    "name": "Settings exposes Telegram sharing control",
    "steps": [
      {
        "send": { "callback": "settings:open" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "Настройте видимость профиля и удалите данные, когда захотите.",
              "reply_markup": {
                "inline_keyboard": [
                  [{ "text": "Мой профиль", "callback_data": "profile:manage" }],
                  [{ "text": "Показывать мой Telegram при взаимной симпатии: Нет", "callback_data": "settings:telegram:toggle" }],
                  [{ "text": "Удалить аккаунт", "callback_data": "settings:delete" }],
                  [{ "text": "⬅️ В меню", "callback_data": "menu:main" }]
                ]
              }
            }
          }
        ]
      },
      {
        "send": { "callback": "settings:telegram:toggle" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": { "text": "Сначала создайте профиль." }
          }
        ]
      }
    ]
  },
  {
    "name": "Private messaging stays behind a mutual match",
    "steps": [
      {
        "send": { "callback": "conversation:open:42-99" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "Этот разговор больше недоступен — взаимная симпатия прекращена или пользователь заблокирован."
            }
          }
        ]
      }
    ]
  }
]
